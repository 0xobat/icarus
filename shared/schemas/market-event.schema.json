{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-event.schema.json",
  "title": "MarketEvent (v2)",
  "description": "Events published by a chain executor to market:events:{base|solana} Redis channels. v2 extends v4.2 with chain discriminator and per-chain `*_specific` sub-objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timestamp", "chain", "sequence", "event_type", "protocol", "correlation_id"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "timestamp": { "type": "string", "format": "date-time" },
    "chain": { "type": "string", "enum": ["base", "solana"] },
    "sequence": { "type": "integer", "minimum": 0, "description": "Per-chain monotonic; gap = dropped events." },
    "event_type": {
      "type": "string",
      "enum": [
        "new_block",
        "new_slot",
        "swap",
        "rate_change",
        "liquidity_change",
        "large_transfer",
        "price_update",
        "oracle_update"
      ]
    },
    "protocol": { "type": "string", "description": "aave_v3, aerodrome, kamino, drift, jupiter, system, ..." },
    "correlation_id": { "type": "string" },
    "symbol": { "type": ["string", "null"] },
    "payload": { "type": "object", "description": "Event-specific payload" },
    "base_specific": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "block_number": { "type": "integer", "minimum": 0 },
        "tx_hash": { "type": ["string", "null"] },
        "log_index": { "type": ["integer", "null"], "minimum": 0 },
        "gas_price_wei": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["block_number"]
    },
    "solana_specific": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "slot": { "type": "integer", "minimum": 0 },
        "signature": { "type": ["string", "null"] },
        "priority_fee_lamports": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["slot"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "chain": { "const": "base" } } },
      "then": {
        "required": ["base_specific"],
        "properties": { "solana_specific": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "chain": { "const": "solana" } } },
      "then": {
        "required": ["solana_specific"],
        "properties": { "base_specific": { "type": "null" } }
      }
    }
  ]
}
