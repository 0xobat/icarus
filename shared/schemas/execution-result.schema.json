{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-result.schema.json",
  "title": "ExecutionResult (v2)",
  "description": "Results published by a chain executor to execution:results:{base|solana}. v2 extends v4.2 with chain discriminator, template_id, candidate_id (echoed from the order), and Solana fields (signature, slot, priority fee).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "order_id", "correlation_id", "timestamp", "chain", "status"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "order_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "chain": { "type": "string", "enum": ["base", "solana"] },
    "status": {
      "type": "string",
      "enum": ["confirmed", "failed", "reverted", "timeout", "rejected_by_guard"]
    },
    "template_id": { "type": ["string", "null"] },
    "candidate_id": { "type": ["string", "null"] },

    "tx_hash": { "type": ["string", "null"], "description": "Base only" },
    "signature": { "type": ["string", "null"], "description": "Solana only" },
    "block_number": { "type": ["integer", "null"], "minimum": 0, "description": "Base only" },
    "slot": { "type": ["integer", "null"], "minimum": 0, "description": "Solana only" },

    "gas_used_wei": { "type": ["string", "null"] },
    "effective_gas_price_wei": { "type": ["string", "null"] },
    "priority_fee_lamports": { "type": ["string", "null"] },
    "fill_price": { "type": ["string", "null"] },
    "amount_out": { "type": ["string", "null"] },

    "revert_reason": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "retry_count": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
