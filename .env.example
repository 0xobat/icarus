# Icarus v2 (Daedalus) — environment template.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
#
# Loaded by docker-compose for every service. Each service ignores vars it
# doesn't need. The Base-side var names below are the exact names
# ts-executor reads (see ts-executor/src/**/*.ts process.env.* references).

# ─────────── Logging ───────────
LOG_LEVEL=info

# ─────────── Database ───────────
POSTGRES_USER=icarus
POSTGRES_PASSWORD=icarus_dev_change_me
POSTGRES_DB=icarus
DATABASE_URL=postgresql+asyncpg://icarus:icarus_dev_change_me@postgres:5432/icarus

# ─────────── Redis ───────────
REDIS_URL=redis://redis:6379/0
# Max stream length before MAXLEN trimming kicks in (ts-executor + workers).
STREAM_MAX_LENGTH=10000

# ─────────── Frontier LLMs (extractor-worker only) ───────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────── Local LLM (decision-engine advisor only) ───────────
INFERENCE_URL=http://inference:11434
OLLAMA_MODEL=deepseek-r1:14b
INFERENCE_TIMEOUT_SECONDS=5

# ─────────── Base chain (SHARED: ts-executor + decision-engine) ───────────
# `CHAIN_ID` is read by BOTH services, but they support different sets:
#   8453     Base mainnet  — both services ✅ (also the value for a Base mainnet FORK)
#   84532    Base Sepolia  — decision-engine ✅ (token registry); ts-executor ✗ (not mapped)
#   11155111 Eth Sepolia   — ts-executor ✅, but this is ETHEREUM Sepolia, NOT Base; the
#            decision-engine has no registry for it, and it lacks Base's venues. Avoid here.
# Key fact: a real swap needs Aerodrome, which is MAINNET-ONLY — so the two services only
# ever co-run for a fill at 8453 (mainnet or a fork), where they already agree. Base Sepolia
# (84532) is for the decision-engine STANDALONE: real reads, order built+gated, no fill.
# See docs/managed-portfolio-task4-go-live-guide.md §0. (ts-executor's missing baseSepolia
# is tracked correctness debt — off the P1 path, so not fixed here.)
CHAIN_ID=8453

# Alchemy endpoints — ts-executor reads ALCHEMY_BASE_* for Base mainnet and
# ALCHEMY_SEPOLIA_* when CHAIN_ID=11155111 (testing path). Provide both if you
# rotate between them.
ALCHEMY_API_KEY=
ALCHEMY_BASE_HTTP_URL=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SEPOLIA_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SEPOLIA_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Listener gate — set to "false" to disable the Base L2 event subscription
# entirely (useful when running paper-mode or pinning to a fixed chain head).
LISTEN_BASE_ENABLED=true

# ─────────── Base wallet (Safe 1-of-2 multisig, ts-executor) ───────────
# Agent EOA private key — the bot's owner #1 in the 1-of-2 Safe. Never logged.
WALLET_PRIVATE_KEY=
# Safe contract address on Base.
SAFE_ADDRESS=
# Human recovery signer (owner #2). Operator-controlled EOA.
SAFE_RECOVERY_ADDRESS=
# Comma-separated allowlist of permitted contract targets. The on-chain
# AllowlistGuard enforces this at the EVM level; this var mirrors it at the
# application level. Empty = reject everything (fail closed).
CONTRACT_ALLOWLIST=
# Per-TX and daily ETH spending caps in wei. Defaults: 0.5 ETH per tx, 2 ETH/day.
SPENDING_CAP_PER_TX_WEI=500000000000000000
SPENDING_CAP_DAILY_WEI=2000000000000000000

# ─────────── Base protocol addresses (ts-executor) ───────────
# Required when CHAIN_ID=8453; ts-executor refuses to boot without these.
AAVE_V3_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# NOTE: v4.2 ts-executor inconsistently reads both AERODROME_ROUTER (adapter)
# and AERODROME_ROUTER_ADDRESS (listener). Set both to the same value until
# the inconsistency is cleaned up post-W1 (tracked separately).
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_POOL_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da

# ─────────── Managed portfolio (decision-engine) ───────────
# The decision-engine runs the managed-portfolio cycle (rebalance WETH/USDC on
# Base toward a strategic split). Strategy DIALS live in config/managed.toml;
# the vars here are the secrets + per-deployment selectors it reads at boot
# (fail-loud if a required one is missing).
CHAIN=base                                    # base | solana — the managed cycle target
MANAGED_CONFIG_PATH=/app/config/managed.toml  # strategy dials (TOML: allocation/rebalance/cadence)
# CHAIN_ID is set in the shared Base-chain block above. For the managed run:
#   84532 → Exp 1: Base Sepolia dry observation (decision-engine standalone).
#   8453  → Exp 2: Base mainnet fork, full stack, real Aerodrome fill.
# Reuses SAFE_ADDRESS (the holdings + swap-recipient wallet) and
# ALCHEMY_BASE_HTTP_URL (point it at the network matching CHAIN_ID) from above.
#
# Token-address overrides (OPTIONAL): CHAIN_ID already selects pre-registered
# USDC/WETH addresses (8453 mainnet, 84532 Base Sepolia). Set these ONLY if a
# registered testnet address is stale — they re-register for the active CHAIN_ID
# at boot with no code change:
# USDC_ADDRESS=
# USDC_DECIMALS=6
# WETH_ADDRESS=
# WETH_DECIMALS=18
#
# Chainlink ETH/USD price feed — network-specific. RpcAdapter defaults to the
# Base MAINNET feed (works for CHAIN_ID=8453 and a mainnet fork). On Base Sepolia
# that address reverts, so set this to the Base Sepolia ETH/USD feed (verified
# live, 8 decimals, "ETH / USD"). Leave UNSET for mainnet/fork.
# CHAINLINK_ETH_USD_ADDRESS=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1   # Base Sepolia ETH/USD

# ─────────── solana-executor runtime env (W7) ───────────
# Names match what the W7 solana-executor process actually reads
# (see solana-executor/src/wallet/squads.ts). Legacy SQUADS_* and
# CHAIN_SOLANA_RPC_* names were removed in the W7 review pass — no
# code read them; they were documentation rot only.
HELIUS_API_KEY=
#
# Required:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# Path INSIDE the container to a Solana CLI–style JSON keypair (64-byte
# array). Mount it via docker-compose volumes; never bake it into the image.
SOLANA_MEMBER_KEYPAIR_PATH=/run/secrets/solana-member-keypair.json
#
# Optional — operator scaffold:
# When SOLANA_MULTISIG_PDA is UNSET, the executor signs with the member
# keypair directly (single-signer fallback; W7 v1 dev/test path).
# When SET, the executor wraps every tx in a Squads proposal — currently
# unimplemented in W7 v1, will throw at sign time. Wire @sqds/multisig
# vault-tx-create + proposal-approve + execute before setting this in prod.
SOLANA_MULTISIG_PDA=
# Optional ComputeBudget priority fee (microlamports per CU).
SOLANA_PRIORITY_FEE_MICROLAMPORTS=

# ─────────── Research data sources ───────────
DUNE_API_KEY=
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_YIELDS_URL=https://yields.llama.fi

# ─────────── Operator alerts ───────────
DISCORD_WEBHOOK_URL=
DISCORD_REPLY_TOKEN_TIMEOUT_HOURS=24
# Comma-separated allowlist of Discord user ids whose APPROVE/REJECT
# replies are accepted. Required for the inbox to accept any reply —
# empty allowlist means no message can authorize a promotion (fail-
# closed). Find your user id in Discord: Settings → Advanced → enable
# Developer Mode, then right-click your name → "Copy User ID".
DISCORD_OPERATOR_USER_IDS=
# Bot REST API credentials for the long-poll reply ingestion path.
# Required (alongside DISCORD_CHANNEL_ID) for the promotion-approval
# round-trip; missing either disables ingestion and lake-governor logs
# a single warning then yields no replies.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ─────────── Grafana ───────────
# Sidecar Grafana on host port 3001 (webapp owns 3000). Reads Postgres
# directly via the provisioned datasource in monitoring/grafana/.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=icarus_dev_change_me

# ─────────── Runtime tuning ───────────
# Operator-declared live capital ceiling in USD. ExposureLimiter divides
# by this to compute per-protocol / per-asset ratios; required for the
# decision-engine to boot (the gate cannot run with an unknown denominator).
DECISION_ENGINE_TOTAL_CAPITAL_USD=10000
# Template registry root. Shared by extractor-worker (writer), backtest-worker
# (registry loader), and decision-engine (registry loader). Must resolve to
# the same on-disk directory inside every container — docker-compose mounts
# ./templates → /app/templates for all three.
TEMPLATES_DIR=/app/templates
# NOTE: the MANAGED decision-engine reads its cadence from config/managed.toml
# ([cadence] interval_seconds), NOT this var. The vars below serve the lake
# services (extractor/backtest/lake-governor), left in the tree pending cleanup.
DECISION_ENGINE_CYCLE_INTERVAL_SECONDS=30
LAKE_GOVERNOR_TICK_INTERVAL_SECONDS=60
EXTRACTOR_VISIBILITY_TIMEOUT_SECONDS=1800
BACKTEST_VISIBILITY_TIMEOUT_SECONDS=14400
BACKTEST_PER_TEMPLATE_BUDGET_SECONDS=7200
