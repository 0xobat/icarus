# Icarus v2 (Daedalus) — environment template.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
#
# Loaded by docker-compose for every service. Each service ignores vars it
# doesn't need. The Base-side var names below are the exact names
# ts-executor reads (see ts-executor/src/**/*.ts process.env.* references).

# ─────────── Logging ───────────
LOG_LEVEL=info

# ─────────── Database ───────────
POSTGRES_USER=icarus
POSTGRES_PASSWORD=icarus_dev_change_me
POSTGRES_DB=icarus
DATABASE_URL=postgresql+asyncpg://icarus:icarus_dev_change_me@postgres:5432/icarus

# ─────────── Redis ───────────
REDIS_URL=redis://redis:6379/0
# Max stream length before MAXLEN trimming kicks in (ts-executor + workers).
STREAM_MAX_LENGTH=10000

# ─────────── Frontier LLMs (extractor-worker only) ───────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────── Local LLM (decision-engine advisor only) ───────────
INFERENCE_URL=http://inference:11434
OLLAMA_MODEL=deepseek-r1:14b
INFERENCE_TIMEOUT_SECONDS=5

# ─────────── Base chain (ts-executor) ───────────
# `CHAIN_ID` selects between Base mainnet (8453) and Sepolia testnet (11155111).
# Defaults to sepolia inside ts-executor/src/config.ts.
CHAIN_ID=8453

# Alchemy endpoints — ts-executor reads ALCHEMY_BASE_* for Base mainnet and
# ALCHEMY_SEPOLIA_* when CHAIN_ID=11155111 (testing path). Provide both if you
# rotate between them.
ALCHEMY_API_KEY=
ALCHEMY_BASE_HTTP_URL=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SEPOLIA_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SEPOLIA_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Listener gate — set to "false" to disable the Base L2 event subscription
# entirely (useful when running paper-mode or pinning to a fixed chain head).
LISTEN_BASE_ENABLED=true

# ─────────── Base wallet (Safe 1-of-2 multisig, ts-executor) ───────────
# Agent EOA private key — the bot's owner #1 in the 1-of-2 Safe. Never logged.
WALLET_PRIVATE_KEY=
# Safe contract address on Base.
SAFE_ADDRESS=
# Human recovery signer (owner #2). Operator-controlled EOA.
SAFE_RECOVERY_ADDRESS=
# Comma-separated allowlist of permitted contract targets. The on-chain
# AllowlistGuard enforces this at the EVM level; this var mirrors it at the
# application level. Empty = reject everything (fail closed).
CONTRACT_ALLOWLIST=
# Per-TX and daily ETH spending caps in wei. Defaults: 0.5 ETH per tx, 2 ETH/day.
SPENDING_CAP_PER_TX_WEI=500000000000000000
SPENDING_CAP_DAILY_WEI=2000000000000000000

# ─────────── Base protocol addresses (ts-executor) ───────────
# Required when CHAIN_ID=8453; ts-executor refuses to boot without these.
AAVE_V3_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# NOTE: v4.2 ts-executor inconsistently reads both AERODROME_ROUTER (adapter)
# and AERODROME_ROUTER_ADDRESS (listener). Set both to the same value until
# the inconsistency is cleaned up post-W1 (tracked separately).
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_POOL_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da

# ─────────── Solana chain (solana-executor) ───────────
HELIUS_API_KEY=
CHAIN_SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
CHAIN_SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Solana Squads multisig — agent EOA, multisig address.
SQUADS_AGENT_PRIVATE_KEY=
SQUADS_ADDRESS=
SQUADS_ALLOWLIST_PROGRAMS=

# ─────────── solana-executor runtime env (W7) ───────────
# These are the exact names the W7 solana-executor process reads
# (see solana-executor/src/wallet/squads.ts). They overlap conceptually with
# the names above; the W7 scaffold uses the SOLANA_* names to keep parity
# with @solana/web3.js / @sqds/multisig SDK conventions. Keep both sets in
# sync until the duplication is cleaned up post-W7.
#
# Required:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# Path INSIDE the container to a Solana CLI–style JSON keypair (64-byte
# array). Mount it via docker-compose volumes; never bake it into the image.
SOLANA_MEMBER_KEYPAIR_PATH=/run/secrets/solana-member-keypair.json
#
# Optional — operator scaffold:
# When SOLANA_MULTISIG_PDA is UNSET, the executor signs with the member
# keypair directly (single-signer fallback; W7 v1 dev/test path).
# When SET, the executor wraps every tx in a Squads proposal — currently
# unimplemented in W7 v1, will throw at sign time. Wire @sqds/multisig
# vault-tx-create + proposal-approve + execute before setting this in prod.
SOLANA_MULTISIG_PDA=
# Optional ComputeBudget priority fee (microlamports per CU).
SOLANA_PRIORITY_FEE_MICROLAMPORTS=

# ─────────── Research data sources ───────────
DUNE_API_KEY=
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_YIELDS_URL=https://yields.llama.fi

# ─────────── Operator alerts ───────────
DISCORD_WEBHOOK_URL=
DISCORD_REPLY_TOKEN_TIMEOUT_HOURS=24

# ─────────── Grafana ───────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_me

# ─────────── Runtime tuning ───────────
DECISION_ENGINE_CYCLE_INTERVAL_SECONDS=30
LAKE_GOVERNOR_TICK_INTERVAL_SECONDS=60
EXTRACTOR_VISIBILITY_TIMEOUT_SECONDS=1800
BACKTEST_VISIBILITY_TIMEOUT_SECONDS=14400
BACKTEST_PER_TEMPLATE_BUDGET_SECONDS=7200
