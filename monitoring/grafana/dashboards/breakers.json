{
  "uid": "icarus-breakers",
  "title": "Icarus — Breakers",
  "tags": ["icarus", "v2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Candidates currently tripped",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "icarus-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*)::int AS value FROM lake_roster WHERE breaker_tripped = true;"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Tripped candidates (heatmap-style state view)",
      "gridPos": { "h": 10, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "icarus-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT candidate_id, template_id, state, allocation_usd, breaker_tripped, last_transition_at FROM lake_roster ORDER BY breaker_tripped DESC, last_transition_at DESC;"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Breaker-related alerts over time",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "postgres", "uid": "icarus-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', timestamp) AS time, severity AS metric, COUNT(*)::int AS value FROM alerts WHERE category LIKE '%breaker%' AND $__timeFilter(timestamp) GROUP BY 1, 2 ORDER BY 1 ASC;"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent breaker alerts",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "icarus-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT timestamp, severity, category, message, acknowledged FROM alerts WHERE category LIKE '%breaker%' ORDER BY timestamp DESC LIMIT 100;"
        }
      ],
      "options": { "showHeader": true }
    }
  ]
}
